{
  "name": "ma-industries",
  "version": "1.0.0",
  "private": true,
  "description": "M&A Industries paper, packaging, sugarcane and recycled products catalogue",
  "type": "module",
  "scripts": {
    "build": "node scripts/site/build.mjs",
    "check": "node scripts/site/check.mjs && node scripts/site/catalogue-markup.mjs",
    "sync:catalogue": "node scripts/site/catalogue-markup.mjs --write",
    "verify:build": "node scripts/site/verify-build.mjs",
    "validate": "npm run check && npm test && npm run build && npm run verify:build",
    "catalogue": "node scripts/catalogue/create-catalogue.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
